# Production settings for the VPS. Never commit the filled-in copy (.env.production).
# Run ./deploy/make-env.sh <your-domain> to create it with random secrets, then fill in
# the storage, email and payment sections below.

# ---- Address -------------------------------------------------------------------------
DOMAIN=__DOMAIN__
APP_URL=https://__DOMAIN__
DJANGO_ALLOWED_HOSTS=__DOMAIN__,localhost
DJANGO_CSRF_TRUSTED_ORIGINS=https://__DOMAIN__

# ---- Secrets (generated by make-env.sh) -----------------------------------------------
DJANGO_SECRET_KEY=__SECRET_KEY__
POSTGRES_ADMIN_PASSWORD=__POSTGRES_ADMIN_PASSWORD__
APP_DB_PASSWORD=__APP_DB_PASSWORD__
# The app connects as photo_app, which is not a superuser, so row-level security applies.
# The password here must match APP_DB_PASSWORD.
DATABASE_URL=postgres://photo_app:__APP_DB_PASSWORD__@db:5432/photo

# ---- Behaviour ------------------------------------------------------------------------
DJANGO_DEBUG=false
# One proxy (Caddy) sits in front of the app. A wrong number breaks the rate limits.
NUM_PROXIES=1
# Start at one hour; raise to 31536000 (one year) once HTTPS has been stable for a while.
DJANGO_HSTS_SECONDS=3600
# Keep false until you have browsed the app and the console shows no important reports,
# then set true.
CSP_ENFORCE=false
TRIAL_DAYS=30

# ---- Photo storage: Cloudflare R2 -----------------------------------------------------
S3_ENDPOINT_INTERNAL=https://YOUR_ACCOUNT_ID.r2.cloudflarestorage.com
S3_ENDPOINT_PUBLIC=https://YOUR_ACCOUNT_ID.r2.cloudflarestorage.com
S3_BUCKET=your-bucket-name
S3_ACCESS_KEY=
S3_SECRET_KEY=
S3_REGION=auto

# ---- Email: SMTP credentials from your email service ----------------------------------
EMAIL_HOST=
EMAIL_PORT=587
EMAIL_HOST_USER=
EMAIL_HOST_PASSWORD=
EMAIL_USE_TLS=true
DEFAULT_FROM_EMAIL=PickSnap <noreply@__DOMAIN__>

# Sharing with clients. Both off: studios share by WhatsApp only and need not confirm their own
# email first. Turn both on once the email service above is working.
CLIENT_EMAIL_SHARING=false
REQUIRE_VERIFIED_EMAIL_TO_SHARE=false

# ---- Google Drive import (leave empty to hide the option) -----------------------------
# A Google Cloud API key with the Google Drive API enabled. Restrict it to that API.
GOOGLE_API_KEY=

# ---- Payments: Razorpay (leave empty to run on free trials only) ----------------------
RAZORPAY_KEY_ID=
RAZORPAY_KEY_SECRET=
RAZORPAY_WEBHOOK_SECRET=

# ---- Error tracking (optional) --------------------------------------------------------
SENTRY_DSN=
SENTRY_ENVIRONMENT=production
