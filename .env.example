# Copy to .env for local development. Never commit .env.

DJANGO_DEBUG=true
DJANGO_SECRET_KEY=dev-only-insecure-key-change-me
DJANGO_ALLOWED_HOSTS=localhost,127.0.0.1,web
DJANGO_CSRF_TRUSTED_ORIGINS=http://localhost:5173
APP_URL=http://localhost:5173

# The app role is not a superuser, so row-level security applies.
DATABASE_URL=postgres://photo_app:photo_app@db:5432/photo

# Mailpit locally; a transactional email service over SMTP elsewhere.
EMAIL_HOST=mail
EMAIL_PORT=1025
DEFAULT_FROM_EMAIL=noreply@localhost

# SeaweedFS locally; Cloudflare R2 elsewhere.
# The server reaches storage at the internal endpoint; the browser uses the public one.
S3_ENDPOINT_INTERNAL=http://storage:8333
S3_ENDPOINT_PUBLIC=http://localhost:8333
S3_BUCKET=photos-dev
S3_ACCESS_KEY=devkey
S3_SECRET_KEY=devsecret
S3_REGION=auto

# Sprint 0 spike endpoints. Local only.
SPIKES_ENABLED=true
